      "intro_he": "השיר המוכר 'הנה מה טוב ומה נעים' — בלטינית. אפשר לשיר אותו באותה מנגינה!",
      "lines": [
        {
          "la": "Ecce quam bonum et quam iucundum",
          "he": "הנה מה טוב ומה נעים",
          "notes": [
            {
              "la": "ecce",
              "he": "הנה!"
            },
            {
              "la": "quam",
              "he": "כמה, מה (בקריאה)"
            },
            {
              "la": "bonum",
              "he": "טוב (bonus בסתמי)"
            },
            {
              "la": "iūcundum",
              "he": "נעים"
            }
          ]
        },
        {
          "la": "habitare fratres in unum!",
          "he": "שבת אחים גם יחד!",
          "notes": [
            {
              "la": "habitāre",
              "he": "לשבת, לגור — ‎-āre היא סיומת שם הפועל"
            },
            {
              "la": "frātrēs",
              "he": "אחים (רבים של frāter)"
