    {
      "id": "genesis",
      "kind": "canon",
      "level": 1,
      "title_la": "In principio",
      "title_he": "בראשית",
      "author_he": "ספר בראשית, בתרגום הלטיני (הוולגטה, המאה ה-4)",
      "intro_he": "הפסוקים הראשונים של התנ\"ך, כפי שקראו אותם באירופה במשך יותר מאלף שנה. כמעט כל המילים החשובות כאן כבר מוכרות לך מהלחשים.",
      "lines": [
        {
          "la": "In principio creavit Deus caelum et terram.",
          "he": "בראשית ברא אלוהים את השמיים ואת הארץ.",
          "notes": [
            {
              "la": "in principiō",
              "he": "בהתחלה — in עם יחסת האמצעי"
            },
            {
              "la": "creāvit",
              "he": "ברא (עבר של creō)"
            },
            {
              "la": "caelum et terram",
              "he": "מושא: terram נגמרת ב-am"
            }
          ]
        },
        {
          "la": "Terra autem erat inanis et vacua,",
          "he": "והארץ הייתה תוהו ובוהו,",
          "notes": [
            {
              "la": "autem",
              "he": "ו-, אבל"
            },
            {
              "la": "erat",
              "he": "הייתה (עבר של sum)"
            },
            {
              "la": "inānis et vacua",
              "he": "ריקה וחלולה — 'תוהו ובוהו'"
            }
          ]
        },
        {
          "la": "et tenebrae erant super faciem abyssi,",
          "he": "וחושך על פני תהום,",
          "notes": [
            {
              "la": "tenebrae erant",
              "he": "החושך היה — tenebrae ברבים, ולכן גם erant ברבים"
            },
            {
              "la": "super faciem",
              "he": "על פני"
            },
            {
              "la": "abyssī",
              "he": "של התהום (צורת השייכות)"
            }
          ]
        },
        {
          "la": "et spiritus Dei ferebatur super aquas.",
          "he": "ורוח אלוהים מרחפת על פני המים.",
          "notes": [
            {
              "la": "spīritus Deī",
              "he": "רוח (של) אלוהים"
            },
            {
              "la": "ferēbātur",
              "he": "ריחפה, נישאה (מ-ferō)"
            },
            {
              "la": "aquās",
              "he": "מים — ברבים, בדיוק כמו בעברית"
            }
          ]
        },
        {
          "la": "Dixitque Deus: Fiat lux. Et facta est lux.",
          "he": "ויאמר אלוהים: יהי אור. ויהי אור.",
          "notes": [
            {
              "la": "dīxitque",
              "he": "ויאמר — ‎-que מוצמדת לסוף מילה ופירושה 'ו-'"
            },
            {
              "la": "fīat lūx",
              "he": "יהי אור"
            },
            {
              "la": "facta est",
              "he": "נהייתה"
            }
          ]
        }
      ],
      "lesson_he": [
        "terra, tenebrae, spīritus, aqua, lūx — המילים מהלחשים שלך מופיעות כאן בטקסט העתיק ביותר שיש.",
        "‎-que היא דרך נוספת לומר 'ו-': מדביקים אותה לסוף המילה (dīxitque = וַיֹּאמֶר).",
        "בעברית 'מים' תמיד ברבים — וגם המתרגם הלטיני בחר כאן ברבים: aquās."
      ]
    },
    {
